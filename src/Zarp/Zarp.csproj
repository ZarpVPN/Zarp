<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Zarp</AssemblyName>
    <RootNamespace>Zarp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>zarp.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Zarp</Product>
    <Description>Cloudflare WARP over zapret2</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- zapret2 вшивается в exe (архив готовит tools\fetch-zapret.ps1). Без него программа скачает zapret2 сама. -->
  <ItemGroup Condition="Exists('..\..\vendor\zapret2.zip')">
    <EmbeddedResource Include="..\..\vendor\zapret2.zip" LogicalName="zapret2.zip" />
  </ItemGroup>
  <Target Name="WarnNoZapret" BeforeTargets="Build" Condition="!Exists('..\..\vendor\zapret2.zip')">
    <Warning Text="vendor\zapret2.zip не найден, zapret2 не будет вшит в exe. Запустите tools\fetch-zapret.ps1." />
  </Target>

  <!-- sing-box (движок собственного сервера) вшивается так же; архив готовит tools\fetch-singbox.ps1. Без него режим «свой сервер» недоступен. -->
  <ItemGroup Condition="Exists('..\..\vendor\singbox.zip')">
    <EmbeddedResource Include="..\..\vendor\singbox.zip" LogicalName="singbox.zip" />
  </ItemGroup>
  <Target Name="WarnNoSingBox" BeforeTargets="Build" Condition="!Exists('..\..\vendor\singbox.zip')">
    <Warning Text="vendor\singbox.zip не найден, sing-box не будет вшит в exe. Запустите tools\fetch-singbox.ps1." />
  </Target>

  <!-- Xray (мост для VLESS поверх XHTTP, который sing-box не умеет) вшивается так же; архив готовит tools\fetch-xray.ps1. Без него ссылки с XHTTP недоступны. -->
  <ItemGroup Condition="Exists('..\..\vendor\xray.zip')">
    <EmbeddedResource Include="..\..\vendor\xray.zip" LogicalName="xray.zip" />
  </ItemGroup>
  <Target Name="WarnNoXray" BeforeTargets="Build" Condition="!Exists('..\..\vendor\xray.zip')">
    <Warning Text="vendor\xray.zip не найден, Xray не будет вшит в exe. Запустите tools\fetch-xray.ps1." />
  </Target>

  <!-- лицензии Zarp и вшитых компонентов: едут внутри exe и распаковываются в %LOCALAPPDATA%\Zarp\licenses -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="licenses/LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="licenses/THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="..\..\licenses\*.txt" LogicalName="licenses/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- встроенные IP-диапазоны России, Ирана и Китая (ipverse/country-ip-blocks, CC0): Routes\<страна>.txt → ресурс routes/<страна>.txt -->
  <ItemGroup>
    <EmbeddedResource Include="Routes\*.txt" LogicalName="routes/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- переводы интерфейса: Lang\<код>.txt → ресурс lang/<код>.txt -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.txt" LogicalName="lang/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
